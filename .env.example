# Supabase — required for all environments
EXPO_PUBLIC_SUPABASE_URL=https://zzfjvhbuhsugwztllxco.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Web-side (Next.js/Vercel) — needed for /app/i/[code] invite page
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App base URL (replace with custom domain when ready)
EXPO_PUBLIC_APP_URL=https://slipstream-app.vercel.app
NEXT_PUBLIC_APP_URL=https://slipstream-app.vercel.app

# Upstash Redis REST Caching (Free Tier)
# Hot reads (leaderboards, hazard tile queries) cached with TTL
EXPO_PUBLIC_UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
EXPO_PUBLIC_UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Connection Pooling Note:
# Supabase uses Supavisor transaction pooling by default on port 6543
# For direct backend queries, connect via:
# postgres://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

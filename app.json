{
  "expo": {
    "name": "Slipstream",
    "slug": "slipstream",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "slipstream",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/space-grotesk/500Medium/SpaceGrotesk_500Medium.ttf",
            "./node_modules/@expo-google-fonts/space-grotesk/600SemiBold/SpaceGrotesk_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/space-grotesk/700Bold/SpaceGrotesk_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070D",
          "image": "./assets/splash-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Slipstream uses your location continuously to record trip routes, detect speed camera zones, and time drag-race runs. Your location data is stored privately on your account.",
          "locationWhenInUsePermission": "Slipstream uses your location to show your position on the map and record trip routes.",
          "locationAlwaysPermission": "Slipstream uses your location in the background to continue recording trips and send radar alerts while the app is minimised.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85ef135f-87ea-466c-b9f3-0abb2c3ab45c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "extra": {
      "eas": {
        "projectId": "85ef135f-87ea-466c-b9f3-0abb2c3ab45c"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.slipstream.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:slipstream-app.vercel.app",
        "applinks:slipstream.app",
        "applinks:www.slipstream.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Slipstream records your trip route and detects radar zones. Location runs in the background so recording continues when the screen is off.",
        "NSLocationWhenInUseUsageDescription": "Slipstream uses your location to display your map position and record trips.",
        "NSLocationAlwaysUsageDescription": "Slipstream records your trip route in the background so you don't have to keep the screen on while driving.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.slipstream.app",
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "slipstream-app.vercel.app",
              "pathPrefix": "/i"
            },
            {
              "scheme": "https",
              "host": "slipstream.app",
              "pathPrefix": "/i"
            },
            {
              "scheme": "https",
              "host": "www.slipstream.app",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "slipstream",
              "host": "i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
